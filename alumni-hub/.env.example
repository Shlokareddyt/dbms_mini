# MySQL 8.0 Connection (Required - Never commit real credentials)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=alumni_hub

# JWT Signing Secret (Generate a long random string)
JWT_SECRET=replace-with-a-64-char-random-secret-key-for-alumni-hub

# Qdrant Vector Database (Option 2 Semantic Search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=alumni_profiles

# Gemini Embeddings API (Option 2 Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

